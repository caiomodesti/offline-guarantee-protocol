{
  "name": "offline-guarantee-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test:ts": "tsc -b && vitest run",
    "vectors:generate": "tsc -b && tsx scripts/generate-vectors.ts",
    "vectors:refresh": "tsc -b && tsx scripts/generate-vectors.ts --refresh",
    "test:rust": "cargo test --manifest-path packages/canonical-codec/rust/Cargo.toml",
    "test:program": "cargo test --manifest-path programs/offline-guarantee/Cargo.toml",
    "test:runtime": "tsx tests/runtime/validator.ts",
    "anchor:build": "anchor build",
    "test": "tsc -b && vitest run && tsx scripts/generate-vectors.ts && cargo test --manifest-path packages/canonical-codec/rust/Cargo.toml && cargo test --manifest-path programs/offline-guarantee/Cargo.toml",
    "check": "tsc -b --pretty false && vitest run && tsx scripts/generate-vectors.ts && cargo test --manifest-path packages/canonical-codec/rust/Cargo.toml && cargo test --manifest-path programs/offline-guarantee/Cargo.toml"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.0.2",
    "@ogp/canonical-codec": "workspace:*",
    "@ogp/credentials": "workspace:*",
    "@ogp/crypto": "workspace:*",
    "@ogp/offline-ledger": "workspace:*",
    "@ogp/shared-types": "workspace:*",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/node": "26.2.0",
    "fast-check": "4.9.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
